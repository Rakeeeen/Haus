rules_version = '2';

// Haus — Firestore security rules.
//
// Everything is denied unless a rule below allows it. Signing in with Google is not enough:
//  - the OWNER is one fixed account (by uid, which can't be spoofed or changed);
//  - a GUEST is a Google account the owner has invited (a document in /members, keyed by the
//    lower-case email), has not switched off, and who has typed in a one-time code the owner gave them.
// Anyone else — a stranger who signed in with Google — can read and write nothing.
//
// Deploy with `node backend/scripts/deploy-rules.js` (the bot's service account; `--rollback` undoes it).
// See docs/ARCHITECTURE.md, "Access".
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who is asking ────────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Hamed. A uid, not an email: it is what Firebase Auth issues for that Google account.
    function isOwner() {
      return signedIn() && request.auth.uid == 'bPw2qdHsBJOwSmrNKMRtlZghfiU2';
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.token.email.lower());
    }

    // An invited guest whose access is switched on.
    function isGuest() {
      return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true;
    }

    function approvalPath(uid) {
      return /databases/$(database)/documents/guest_approvals/$(uid);
    }

    function projectPath(id) {
      return /databases/$(database)/documents/work_projects/$(id);
    }

    function taskPath(id) {
      return /databases/$(database)/documents/work_tasks/$(id);
    }

    function codePath(uid) {
      return /databases/$(database)/documents/guest_codes/$(uid);
    }

    // An invited guest who typed in a code Hamed gave them, less than 30 days ago (domain/access.ts
    // writes the same number). Being invited alone gets a guest nothing but the right to ask for a code.
    function isApprovedGuest() {
      return isGuest()
        && exists(approvalPath(request.auth.uid))
        && request.time < get(approvalPath(request.auth.uid)).data.approvedAt + duration.value(30, 'd');
    }

    // The signed-in person's own area, named by their uid: the owner, or a guest let in.
    function isSelf(uid) {
      return (isOwner() || isApprovedGuest()) && request.auth.uid == uid;
    }

    // Hamed's own area only — the fingerprint is his, and so is a new device's code.
    function isOwnerSelf(uid) {
      return isOwner() && request.auth.uid == uid;
    }

    // A document may only hold the fields it is meant to hold.
    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    // ── The owner's dashboard (water, focus, finance …) ──────────────────────────────
    // Exactly what useFirebaseSync and the bot write: { value, updatedAt }. Guests never touch it.
    match /dashboard/{key} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && onlyKeys(['value', 'updatedAt'])
        && request.resource.data.updatedAt is string;
    }

    // ── A guest's own dashboard: the same shape, in their own area ───────────────────
    match /users/{uid}/data/{key} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && onlyKeys(['value', 'updatedAt'])
        && request.resource.data.updatedAt is string;
    }

    // ── Fingerprint sign-in and the new-device code: Hamed's alone ───────────────────
    match /biometric_credentials/{uid} {
      allow read, delete: if isOwnerSelf(uid);
      allow create, update: if isOwnerSelf(uid) && onlyKeys(['byHost']);
    }

    match /device_auth_codes/{uid} {
      allow read, delete: if isOwnerSelf(uid);
      allow create, update: if isOwnerSelf(uid)
        && onlyKeys(['pending', 'code', 'requestedAt', 'expiresAt', 'used']);
    }

    // ── A guest comes in with a code ──────────────────────────────────────────────────
    // 1. The guest asks (guest_requests). Hamed's screen sees it and writes a one-time code into
    //    guest_codes, which only he can read — the guest never sees it, only Hamed's voice or message.
    // 2. The guest types the code. They can't read guest_codes, but these rules can: the approval is created
    //    only if what they typed equals the stored code and it hasn't expired. Nothing else can create it.
    // 3. Every guest rule above then asks for that approval (isApprovedGuest).
    match /guest_requests/{uid} {
      allow read, delete: if isOwner();
      allow create, update: if isGuest() && request.auth.uid == uid
        && onlyKeys(['email', 'name', 'photoUrl', 'requestedAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('photoUrl', '') is string
        && request.resource.data.requestedAt == request.time;
    }

    // Who a guest is, so Hamed's app can put them on projects by name: they write their own, he reads them.
    match /guest_profiles/{uid} {
      allow read: if isOwner();
      allow create, update: if isGuest() && request.auth.uid == uid
        && onlyKeys(['email', 'name', 'photoUrl'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('photoUrl', '') is string;
    }

    match /guest_codes/{uid} {
      allow read, write: if isOwner();
    }

    match /guest_approvals/{uid} {
      allow list, delete: if isOwner();
      allow get: if isOwner() || (isGuest() && request.auth.uid == uid);
      // A fresh code replaces an approval only once the old one has run out.
      allow create, update: if isGuest() && request.auth.uid == uid
        && onlyKeys(['code', 'approvedAt'])
        && request.resource.data.approvedAt == request.time
        && request.resource.data.code is string
        && exists(codePath(uid))
        && request.resource.data.code == get(codePath(uid)).data.code
        && get(codePath(uid)).data.expiresAt > request.time.toMillis()
        && (resource == null || request.time >= resource.data.approvedAt + duration.value(30, 'd'));
    }

    // ── Pausing Haus for everyone ─────────────────────────────────────────────────────
    // One document, system/status: { paused, message?, updatedAt }. Hamed's switch writes it; every invited guest's screen
    // listens to it and shows a "resting" page while it says paused. (It stops the screens, not the data: the rules above
    // deliberately do not look it up, because each lookup in a rule is a billed read.)
    match /system/status {
      allow read: if isOwner() || isGuest();
      allow create, update: if isOwner()
        && onlyKeys(['paused', 'message', 'updatedAt'])
        && request.resource.data.paused is bool
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 200
        && request.resource.data.updatedAt is string;
    }

    // ── What a guest does, for Hamed to read (and the bot to tell Discord) ────────────
    // A line per action: signing in, adding / moving / deleting a task, a comment. A guest can add one about themself
    // (never about someone else, never to change or remove one); only Hamed reads them.
    match /activity_log/{id} {
      allow read, delete: if isOwner();
      allow create: if isApprovedGuest()
        && onlyKeys(['uid', 'name', 'type', 'text', 'taskId', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.type in ['entered', 'task_created', 'task_status', 'task_deleted', 'comment']
        && request.resource.data.text is string && request.resource.data.text.size() <= 240
        && request.resource.data.get('taskId', '') is string
        && request.resource.data.at == request.time;
    }

    // ── Work: projects, tasks, their comments, and notes ─────────────────────────────
    // Hamed reads and writes all of it. A guest (let in by a code) sees only a project they are a member of, and a task
    // whose `viewerUids` lists them — Hamed's app writes those lists from each project's sharing (domain/work/sharing.ts).
    // A guest may add a task for themself (in a project they are on, or none) and change the tasks that are theirs, but
    // never a task's project, who it is for, or who may see it. A project's client is in its own document, Hamed's alone.
    // A project's ADMINS (`adminUids`, chosen by Hamed from its members) run it with him: they see all of its tasks, make
    // and change its tasks and give them to its members (or Hamed), and change the project's name, status, priority and
    // dates — never who is on it, who the admins are, or its client.
    match /work_projects/{id} {
      allow read: if isOwner() || (isApprovedGuest() && request.auth.uid in resource.data.memberUids);
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isApprovedGuest()
        && request.auth.uid in resource.data.get('adminUids', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'priority', 'date', 'endDate', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200);
    }

    match /work_projects_private/{id} {
      allow read, write: if isOwner();
    }

    function guestMayAddTask() {
      let d = request.resource.data;
      // `projectIds` (several projects) is Hamed's alone: a guest's task is in one project at most.
      return onlyKeys(['no', 'title', 'status', 'priority', 'date', 'endDate', 'projectId', 'assignee', 'assigneeUid', 'createdByUid',
                       'viewerUids', 'tags', 'description', 'createdAt', 'updatedAt', 'doneAt'])
        && d.no == 0
        && d.createdByUid == request.auth.uid
        && d.assigneeUid == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.status in ['todo', 'doing', 'done', 'dropped']
        && (d.projectId == null
            ? d.viewerUids == [request.auth.uid]
            : request.auth.uid in get(projectPath(d.projectId)).data.memberUids
              // The project's members when it shares everything; otherwise this guest and the project's admins.
              && d.viewerUids.toSet() == (get(projectPath(d.projectId)).data.guestsSeeAll
                                          ? get(projectPath(d.projectId)).data.memberUids.toSet()
                                          : [request.auth.uid].toSet().union(get(projectPath(d.projectId)).data.get('adminUids', []).toSet())));
    }

    // Who may see a task in project `p` that is for `assignees` and was made by `maker`: all the members, or — when the project
    // does not share everything — the members it is for, the one who made it, and the admins (domain/work/sharing.ts, viewersOf).
    function viewersFor(p, assignees, maker) {
      return p.guestsSeeAll
        ? p.memberUids.toSet()
        : assignees.toSet().union([maker].toSet()).union(p.get('adminUids', []).toSet()).intersection(p.memberUids.toSet());
    }

    // A project's admin making a task in it: for any of the members (or Hamed), seen by whoever the project says.
    function adminMayAddTask() {
      let d = request.resource.data;
      let p = get(projectPath(d.projectId)).data;
      return onlyKeys(['no', 'title', 'status', 'priority', 'date', 'endDate', 'projectId', 'assignee', 'assigneeUid', 'assigneeUids', 'createdByUid',
                       'updatedByUid', 'viewerUids', 'tags', 'description', 'createdAt', 'updatedAt', 'doneAt'])
        && d.projectId is string
        && request.auth.uid in p.get('adminUids', [])
        && d.no == 0
        && d.createdByUid == request.auth.uid
        && d.updatedByUid == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.status in ['todo', 'doing', 'done', 'dropped']
        && d.assigneeUids is list && d.assigneeUids.size() > 0
        && d.assigneeUids.hasOnly(p.memberUids.concat(['owner']))
        && d.viewerUids.toSet() == viewersFor(p, d.assigneeUids, request.auth.uid);
    }

    // A project's admin changing a task that is in that project alone (a task in several is Hamed's to arrange). If they change
    // who it is for, who may see it is changed with it, to what the project says.
    function adminMayEditTask() {
      let before = resource.data;
      let d = request.resource.data;
      let p = get(projectPath(before.projectId)).data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return before.projectId is string
        && before.get('projectIds', []).size() <= 1
        && request.auth.uid in p.get('adminUids', [])
        && changed.hasOnly(['title', 'status', 'priority', 'date', 'endDate', 'description', 'tags', 'doneAt', 'updatedAt',
                            'assignee', 'assigneeUid', 'assigneeUids', 'viewerUids', 'updatedByUid'])
        && d.updatedByUid == request.auth.uid
        && d.title is string && d.title.size() <= 300
        && (!changed.hasAny(['assigneeUids', 'viewerUids'])
            || (d.assigneeUids is list && d.assigneeUids.size() > 0
                && d.assigneeUids.hasOnly(p.memberUids.concat(['owner']))
                && d.viewerUids.toSet() == viewersFor(p, d.assigneeUids, before.get('createdByUid', null))));
    }

    function guestMayEditTask() {
      // A task can be for several people (`assigneeUids`, Hamed's to write); a guest it is for may change it, like its first one.
      return (resource.data.assigneeUid == request.auth.uid || resource.data.createdByUid == request.auth.uid
              || request.auth.uid in resource.data.get('assigneeUids', []))
        && request.auth.uid in resource.data.viewerUids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'status', 'priority', 'date', 'endDate', 'description', 'tags', 'doneAt', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 300;
    }

    match /work_tasks/{id} {
      allow read: if isOwner() || (isApprovedGuest() && request.auth.uid in resource.data.viewerUids);
      allow create: if isOwner() || (isApprovedGuest() && (guestMayAddTask() || adminMayAddTask()));
      allow update: if isOwner() || (isApprovedGuest() && (guestMayEditTask() || adminMayEditTask()));
      allow delete: if isOwner() || (isApprovedGuest() && (resource.data.createdByUid == request.auth.uid
        || (resource.data.projectId is string && resource.data.get('projectIds', []).size() <= 1
            && request.auth.uid in get(projectPath(resource.data.projectId)).data.get('adminUids', []))));

      match /comments/{commentId} {
        allow read: if isOwner() || (isApprovedGuest() && request.auth.uid in get(taskPath(id)).data.viewerUids);
        allow create: if isOwner() || (isApprovedGuest()
          && request.auth.uid in get(taskPath(id)).data.viewerUids
          && onlyKeys(['author', 'authorUid', 'text', 'at'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000);
        allow update: if isOwner();
        allow delete: if isOwner() || (isApprovedGuest() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /work_notes/{id} {
      allow read, write: if isOwner();
    }

    // ── Markers of what was deleted ──────────────────────────────────────────────────
    // Hamed's devices read his tasks and notes by their changes only (src/data/deltaSync.ts): a deleted document leaves a marker
    // { at } here, which is how they learn it is gone. Only he reads them. Anyone working here may leave one for a task, but only
    // once the task no longer exists — a marker can never hide a live task.
    match /work_tasks_deleted/{id} {
      allow read: if isOwner();
      allow create, update: if (isOwner() || isApprovedGuest())
        && onlyKeys(['at'])
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && !exists(taskPath(id));
    }

    match /work_notes_deleted/{id} {
      allow read: if isOwner();
      allow create, update: if isOwner() && onlyKeys(['at']) && request.resource.data.at is string;
    }

    match /work_projects_private_deleted/{id} {
      allow read: if isOwner();
      allow create, update: if isOwner() && onlyKeys(['at']) && request.resource.data.at is string;
    }

    match /work_projects_deleted/{id} {
      allow read: if isOwner();
      allow create, update: if isOwner() && onlyKeys(['at']) && request.resource.data.at is string;
    }

    // ── Invitations: only the owner manages them; a guest can read just their own ────
    match /members/{email} {
      allow get: if isOwner() || (signedIn() && email == request.auth.token.email.lower());
      allow list: if isOwner();
      allow create, update: if isOwner()
        && email == email.lower()
        && onlyKeys(['email', 'active', 'addedAt', 'name', 'uid', 'photoUrl'])
        && request.resource.data.email == email
        && request.resource.data.active is bool;
      allow delete: if isOwner();
    }

    // Anything not named above is closed — including collections that don't exist yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
